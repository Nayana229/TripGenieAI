rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCurrency(currency) {
      return currency in ['USD', 'EUR', 'GBP', 'JPY', 'INR', 'AUD', 'CAD', 'CHF'];
    }

    function isValidPersonality(personality) {
      return personality in ['Adventure', 'Nature', 'Food', 'Spiritual', 'Luxury', 'Budget'];
    }

    function isValidStatus(status) {
      return status in ['upcoming', 'completed', 'draft'];
    }

    function isValidDateStr(dateStr) {
      return dateStr is string && dateStr.size() == 10 && dateStr.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidUserProfile(data, userId) {
      return data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && isValidCurrency(data.preferredCurrency)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrip(data, tripId) {
      return data.id is string
        && isValidId(data.id)
        && data.id == tripId
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 140
        && data.startLocation is string
        && data.startLocation.size() >= 2
        && data.startLocation.size() <= 120
        && data.destination is string
        && data.destination.size() >= 2
        && data.destination.size() <= 120
        && isValidDateStr(data.startDate)
        && isValidDateStr(data.endDate)
        && data.travellers is int
        && data.travellers >= 1
        && data.travellers <= 20
        && (data.totalBudget is int || data.totalBudget is float)
        && data.totalBudget > 0
        && data.totalBudget <= 100000000
        && isValidCurrency(data.currency)
        && isValidPersonality(data.personality)
        && data.accommodation is string
        && data.accommodation.size() >= 2
        && data.accommodation.size() <= 80
        && data.preferences is list
        && data.preferences.size() <= 12
        && (data.preferences.size() == 0 || (data.preferences[0] is string && data.preferences[0].size() <= 60))
        && isValidStatus(data.status)
        && data.notes is string
        && data.notes.size() <= 1000
        && data.itinerary is map
        && data.itinerary.keys().hasAll(['overview', 'budgetAnalysis', 'days'])
        && data.itinerary.keys().hasOnly(['overview', 'budgetAnalysis', 'days'])
        && data.itinerary.overview is map
        && data.itinerary.budgetAnalysis is map
        && data.itinerary.days is list
        && data.itinerary.days.size() >= 1
        && data.itinerary.days.size() <= 14
        && data.itinerary.days[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTripMessage(data, tripId, messageId) {
      return data.id is string
        && isValidId(data.id)
        && data.id == messageId
        && data.tripId is string
        && isValidId(data.tripId)
        && data.tripId == tripId
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.role in ['user', 'assistant']
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 6000
        && data.appliedUpdate is bool
        && data.createdAt is timestamp;
    }

    function ownsParentTrip(tripId) {
      return exists(/databases/$(database)/documents/trips/$(tripId))
        && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && incoming().keys().hasAll(['uid', 'displayName', 'email', 'preferredCurrency', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'displayName', 'email', 'preferredCurrency', 'createdAt', 'updatedAt'])
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredCurrency', 'updatedAt']);
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow get: if isSignedIn() && isValidId(tripId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(tripId)
        && incoming().keys().hasAll([
          'id', 'userId', 'title', 'startLocation', 'destination', 'startDate', 'endDate',
          'travellers', 'totalBudget', 'currency', 'personality', 'accommodation',
          'preferences', 'status', 'notes', 'itinerary', 'createdAt', 'updatedAt'
        ])
        && incoming().keys().hasOnly([
          'id', 'userId', 'title', 'startLocation', 'destination', 'startDate', 'endDate',
          'travellers', 'totalBudget', 'currency', 'personality', 'accommodation',
          'preferences', 'status', 'notes', 'itinerary', 'createdAt', 'updatedAt'
        ])
        && isValidTrip(incoming(), tripId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(tripId)
        && isValidTrip(incoming(), tripId)
        && existing().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().status != 'completed' && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'startLocation', 'destination', 'startDate', 'endDate',
            'travellers', 'totalBudget', 'currency', 'personality', 'accommodation',
            'preferences', 'status', 'notes', 'itinerary', 'updatedAt'
          ]))
          || (existing().status == 'completed' && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'notes', 'updatedAt'
          ]))
        );
      allow delete: if isVerifiedUser() && isValidId(tripId) && existing().userId == request.auth.uid;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(tripId) && isValidId(messageId) && ownsParentTrip(tripId);
        allow list: if isSignedIn() && existing().userId == request.auth.uid && existing().tripId == tripId;
        allow create: if isVerifiedUser()
          && isValidId(tripId)
          && isValidId(messageId)
          && incoming().keys().hasAll(['id', 'tripId', 'userId', 'role', 'content', 'appliedUpdate', 'createdAt'])
          && incoming().keys().hasOnly(['id', 'tripId', 'userId', 'role', 'content', 'appliedUpdate', 'createdAt'])
          && isValidTripMessage(incoming(), tripId, messageId)
          && incoming().createdAt == request.time
          && ownsParentTrip(tripId);
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(tripId) && isValidId(messageId) && ownsParentTrip(tripId);
      }
    }
  }
}
